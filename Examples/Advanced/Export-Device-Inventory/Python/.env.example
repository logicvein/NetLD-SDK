NETLD_BASE_URL=https://netld.example.com
NETLD_API_KEY=replace-with-an-api-key

# Comma-separated managed network names.
NETLD_NETWORKS=Default
NETLD_OUTPUT_FORMAT=csv
# Leave empty to use inventory.csv or inventory.json according to the format.
NETLD_OUTPUT_FILE=
NETLD_PAGE_SIZE=500

# Leave the query empty to export every device in the selected networks.
NETLD_SEARCH_SCHEME=ipAddress
NETLD_SEARCH_QUERY=
