Set-StrictMode -Version Latest
class AdvancedExampleError : System.Exception { AdvancedExampleError([string]$message):base($message){} }
$script:HardwareFields=@('network','deviceIpAddress','hostname','adapterId','hardwareId','deviceId','assetType','make','modelNumber','serialNumber','partNumber','fruPartNumber','firmwareVersion','hardwareVersion','revisionNumber','rmaNumber','description','slotNumber','slotType','cpuType','cpuDescription','endOfSale','endOfLife','captureTime','latest','cardParentId')
$script:FailureFields=@('network','deviceIpAddress','hostname','error')
function Get-Value($Object,[string]$Name){if($null-eq$Object){return $null};$property=$Object.PSObject.Properties[$Name];if($property){$property.Value}else{$null}}
function Import-DotEnv([string]$Path){if(-not(Test-Path -LiteralPath $Path)){return};foreach($raw in Get-Content -LiteralPath $Path){if($raw -match '^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$' -and -not $raw.TrimStart().StartsWith('#')){$value=$Matches[2].Trim();if(($value.StartsWith('"')-and$value.EndsWith('"'))-or($value.StartsWith("'")-and$value.EndsWith("'"))){$value=$value.Substring(1,$value.Length-2)};[Environment]::SetEnvironmentVariable($Matches[1],$value)}}}
function ConvertTo-HardwareRow($Device,$Hardware){$row=[ordered]@{};foreach($field in $script:HardwareFields){$row[$field]=Get-Value $Hardware $field};$row.network=Get-Value $Device 'network';$row.deviceIpAddress=Get-Value $Device 'ipAddress';$row.hostname=Get-Value $Device 'hostname';$row.adapterId=Get-Value $Device 'adapterId';[pscustomobject]$row}
function Write-AtomicCsv([object[]]$Rows,[string[]]$Fields,[string]$Path){$directory=Split-Path -Parent $Path;if(-not$directory){$directory='.'};[IO.Directory]::CreateDirectory($directory)|Out-Null;$temporary=Join-Path $directory ".$([IO.Path]::GetFileName($Path)).$([guid]::NewGuid()).tmp";try{if($Rows.Count){$Rows|Select-Object -Property $Fields|Export-Csv -LiteralPath $temporary -NoTypeInformation -Encoding utf8}else{$empty=[ordered]@{};foreach($field in $Fields){$empty[$field]=$null};@([pscustomobject]$empty|ConvertTo-Csv -NoTypeInformation)[0]|Set-Content -LiteralPath $temporary -Encoding utf8};[IO.File]::Move($temporary,$Path,$true)}finally{if(Test-Path -LiteralPath $temporary){Remove-Item -LiteralPath $temporary -Force}}}
function Write-AtomicJson([object[]]$Rows,[string]$Path){$directory=Split-Path -Parent $Path;if(-not$directory){$directory='.'};[IO.Directory]::CreateDirectory($directory)|Out-Null;$temporary=Join-Path $directory ".$([IO.Path]::GetFileName($Path)).$([guid]::NewGuid()).tmp";try{$json=if($Rows.Count){ConvertTo-Json -InputObject @($Rows) -Depth 20}else{'[]'};[IO.File]::WriteAllText($temporary,$json+[Environment]::NewLine,[Text.UTF8Encoding]::new($false));[IO.File]::Move($temporary,$Path,$true)}finally{if(Test-Path -LiteralPath $temporary){Remove-Item -LiteralPath $temporary -Force}}}
function Get-NetLDInventoryDevices([scriptblock]$FetchPage,[int]$PageSize){if($PageSize-le 0){throw[AdvancedExampleError]::new('NETLD_PAGE_SIZE must be a positive integer.')};$offset=0;$total=$null;while($true){$page=&$FetchPage $offset $PageSize;if(-not$page){throw[AdvancedExampleError]::new('Inventory.search returned no page data.')};$devices=@($page.devices);foreach($device in $devices){Write-Output $device};$returned=if($page.PSObject.Properties['pageSize']-and$page.pageSize){[int]$page.pageSize}else{$PageSize};if($returned-le 0){throw[AdvancedExampleError]::new('Inventory.search returned an invalid page size.')};if($null-eq$total-and$page.PSObject.Properties['total']-and$null-ne$page.total){$total=[int]$page.total};if($null-ne$total-and$offset+$devices.Count-ge$total){break};if($null-eq$total-and$devices.Count-lt$returned){break};if(-not$devices.Count){throw[AdvancedExampleError]::new('Inventory.search returned an empty page before the reported total.')};$offset+=$returned}}
function Export-NetLDHardwareData([object[]]$Devices,[scriptblock]$FetchHardware,[string]$OutputPath,[string]$FailurePath,[string]$OutputFormat='csv'){$format=$OutputFormat.ToLowerInvariant();if($format-notin@('csv','json')){throw[AdvancedExampleError]::new('NETLD_OUTPUT_FORMAT must be either csv or json.')};$rows=[Collections.Generic.List[object]]::new();$failures=[Collections.Generic.List[object]]::new();foreach($device in $Devices){try{foreach($hardware in @(&$FetchHardware $device)){$rows.Add((ConvertTo-HardwareRow $device $hardware))}}catch{$failures.Add([pscustomobject][ordered]@{network=Get-Value $device 'network';deviceIpAddress=Get-Value $device 'ipAddress';hostname=Get-Value $device 'hostname';error=$_.Exception.Message})}};if($format-eq'csv'){Write-AtomicCsv @($rows) $script:HardwareFields $OutputPath}else{Write-AtomicJson @($rows) $OutputPath};Write-AtomicCsv @($failures) $script:FailureFields $FailurePath;[pscustomobject]@{DeviceCount=$Devices.Count;HardwareCount=$rows.Count;FailureCount=$failures.Count}}
function New-NetLDSession([string]$BaseUrl,[string]$ApiKey,[int]$Timeout){$session=$null;try{Invoke-WebRequest -Uri "$($BaseUrl.TrimEnd('/'))/rest" -Headers @{Authorization="Bearer $ApiKey"} -SessionVariable session -MaximumRedirection 0 -TimeoutSec $Timeout|Out-Null}catch{throw[AdvancedExampleError]::new("Could not authenticate to $BaseUrl.")};$session}
function Invoke-NetLDCall($Connection,[string]$Method,$Parameters){$body=@{jsonrpc='2.0';method=$Method;params=$Parameters;id=[guid]::NewGuid().ToString()}|ConvertTo-Json -Depth 30;try{$response=Invoke-WebRequest -Uri "$($Connection.BaseUrl)/rest" -Method Post -Headers @{Authorization="Bearer $($Connection.ApiKey)";'Content-Type'='application/json'} -Body $body -WebSession $Connection.Session -MaximumRedirection 0 -TimeoutSec $Connection.Timeout}catch{throw[AdvancedExampleError]::new("netLD API call $Method failed.")};$data=$response.Content|ConvertFrom-Json;$errorProperty=$data.PSObject.Properties['error'];if($errorProperty-and$errorProperty.Value){throw[AdvancedExampleError]::new("netLD API call $Method failed: $($errorProperty.Value|ConvertTo-Json -Compress -Depth 10)")};$result=$data.PSObject.Properties['result'];if(-not$result){throw[AdvancedExampleError]::new("netLD API call $Method returned no result field.")};$result.Value}
function Invoke-ExportHardwareInventory([string]$EnvPath,[string]$Format){Import-DotEnv $EnvPath;$baseUrl=$env:NETLD_BASE_URL;$apiKey=$env:NETLD_API_KEY;if(-not$baseUrl-or-not$apiKey){throw[AdvancedExampleError]::new('Set NETLD_BASE_URL and NETLD_API_KEY in the environment file.')};$networks=@((($env:NETLD_NETWORKS ?? 'Default')).Split(',')|ForEach-Object{$_.Trim()}|Where-Object{$_}|Sort-Object -Unique);if(-not$networks.Count){throw[AdvancedExampleError]::new('NETLD_NETWORKS must contain at least one managed network.')};$pageSize=if($env:NETLD_PAGE_SIZE){[int]$env:NETLD_PAGE_SIZE}else{500};$formatValue=if($Format){$Format.ToLowerInvariant()}elseif($env:NETLD_OUTPUT_FORMAT){$env:NETLD_OUTPUT_FORMAT.ToLowerInvariant()}else{'csv'};if($formatValue-notin@('csv','json')){throw[AdvancedExampleError]::new('NETLD_OUTPUT_FORMAT must be either csv or json.')};$resolve={param($value,$default)if(-not$value){$value=$default};if([IO.Path]::IsPathRooted($value)){$value}else{Join-Path $PSScriptRoot $value}};$output=&$resolve $env:NETLD_OUTPUT_FILE "hardware-inventory.$formatValue";$failure=&$resolve $env:NETLD_FAILURE_FILE 'hardware-failures.csv';$scheme=$env:NETLD_SEARCH_SCHEME ?? 'ipAddress';$query=$env:NETLD_SEARCH_QUERY ?? '';if(-not$query.EndsWith("`n")){$query+="`n"};$timeout=if($env:REQUEST_TIMEOUT_SECONDS){[int]$env:REQUEST_TIMEOUT_SECONDS}else{30};$connection=@{BaseUrl=$baseUrl.TrimEnd('/');ApiKey=$apiKey;Timeout=$timeout;Session=New-NetLDSession $baseUrl $apiKey $timeout};$fetchPage={param($offset,$size)Invoke-NetLDCall $connection 'Inventory.search' @{network=$networks;scheme=$scheme;query=$query;pageData=@{offset=$offset;pageSize=$size};sortColumn='ipAddress';descending=$false}};$fetchHardware={param($device)@(Invoke-NetLDCall $connection 'Inventory.getDeviceHardware' @{network=$device.network;ipAddress=$device.ipAddress})};$devices=@(Get-NetLDInventoryDevices $fetchPage $pageSize);$result=Export-NetLDHardwareData $devices $fetchHardware $output $failure $formatValue;Write-Host "Processed $($result.DeviceCount) devices and wrote $($result.HardwareCount) hardware records to $output";Write-Host "Wrote $($result.FailureCount) device lookup failures to $failure";$result}
Export-ModuleMember -Function ConvertTo-HardwareRow,Get-NetLDInventoryDevices,Export-NetLDHardwareData,Invoke-ExportHardwareInventory
